# ===================== TheTradoor Agent =====================
# Copy ke .env lalu isi. Nama variabel = nama field di config.py (huruf besar).

# --- core ---
# dry_run | confirm | live
MODE=dry_run
DATA_DIR=./data
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta
# Wajib "yes" kalau MODE=live. Sengaja dibikin ribet.
I_UNDERSTAND_LIVE_TRADING=

# --- telegram ops (remote control + alert) ---
TELEGRAM_BOT_TOKEN=
# contoh: 123456789,987654321
TELEGRAM_OWNER_IDS=
# opsional; kosong = DM semua owner
TELEGRAM_ALERT_CHAT_ID=

# --- data / rpc ---
HELIUS_API_KEY=
# opsional, override URL Helius
SOLANA_RPC_URL=
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# API key PumpPortal (ditempel sebagai ?api-key=). Sub token baru + migrasi gratis.
PUMPPORTAL_API_KEY=
# subscribeTokenTrade untuk watchlist: BERBAYAR 0.01 SOL / 10k event, butuh key + wallet terhubung
PUMPPORTAL_TRADE_SUBS=false
PUMPPORTAL_TRADE_SUBS_MAX=20

# --- gmgn openapi (Pro = rate weight 50/detik) ---
GMGN_API_KEY=
GMGN_HOST=https://openapi.gmgn.ai
GMGN_RATE_WEIGHT=50
GMGN_BUDGET_FRACTION=0.8
GMGN_CACHE_SEC=15
GMGN_TIMEOUT_SEC=6

# --- screener (fase 1) ---
SCREEN_FIRST_CHECK_SEC=45
SCREEN_RECHECK_SEC=30
SCREEN_MAX_AGE_SEC=1800
SCREEN_MAX_WATCHLIST=150
SCREEN_ALERT_MAX_PER_HOUR=20
# buang token 'mati': setelah N cek masih < M holder dan belum pernah lolos
SCREEN_DEAD_AFTER_CHECKS=3
SCREEN_DEAD_MAX_HOLDERS=10
# token yang berhenti tumbuh dicek makin jarang (maks interval x N)
SCREEN_STAGNANT_BACKOFF_MAX=4

# --- cheap gates (dari event launch, tanpa API) ---
CHEAP_MAX_DEV_BUY_SOL=3.0
CHEAP_MAX_DEV_SUPPLY_PCT=0.08

# --- hard gates (dari GMGN; rate = pecahan 0-1). Bisa dioverride live via /set ---
GATE_MIN_HOLDERS=30
GATE_MIN_LIQUIDITY_USD=3000
GATE_MIN_MCAP_USD=8000
GATE_MAX_MCAP_USD=250000
GATE_MAX_TOP10=0.45
GATE_MAX_DEV_HOLD=0.15
GATE_MAX_BUNDLER=0.20
GATE_MAX_RAT=0.20
GATE_MAX_SNIPERS=15
GATE_MAX_SNIPER_HOLD=0.30
GATE_MAX_ENTRAPMENT=0.10
GATE_REQUIRE_RENOUNCED=true

# --- wallet (HOT WALLET TERPISAH, saldo secukupnya) ---
# base58; kosongkan selama dry_run
WALLET_PRIVATE_KEY=

# --- paper / risk ---
# saldo awal virtual buat grafik balance di dry_run
PAPER_START_SOL=5.0
POSITION_SIZE_SOL=0.1
MAX_OPEN_POSITIONS=3
DAILY_LOSS_CAP_SOL=0.5
COOLDOWN_AFTER_LOSS_SEC=300
LLM_LANE_SIZE_MULT=0.5

# --- routing ---
SCORE_HIGH=80
SCORE_LOW=50
GREY_MIN_TOKEN_AGE_SEC=180

# --- llm lane (grey zone) ---
ANTHROPIC_API_KEY=
LLM_LANE_ENABLED=false
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SEC=2.5
LLM_VERDICT_CACHE_SEC=300
LLM_MAX_BOOST=15
LLM_MIN_CONFIDENCE=0.6

# --- web dashboard (http://IP-VPS:8787/?token=...) ---
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8787
# kosong = dibuat otomatis sekali, disimpan di tabel params, dikirim ke Telegram saat start
WEB_TOKEN=
# opsional, cuma buat link di pesan Telegram, misal http://148.230.100.45:8787
WEB_PUBLIC_URL=

# --- supervisor ---
HEARTBEAT_STALE_SEC=60
WATCHDOG_INTERVAL_SEC=10
EVENTS_RETENTION_DAYS=7
